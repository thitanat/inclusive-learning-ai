# ====================================
# Production Environment Configuration Template
# ====================================
# ⚠️ IMPORTANT: This file is a TEMPLATE only
# Copy this to .env.production and add real production values
# .env.production is gitignored and should NEVER be committed

# ====================================
# Application Settings
# ====================================
NODE_ENV=production
PORT=3005
HOSTNAME=0.0.0.0

# ====================================
# MongoDB Configuration (Production)
# ====================================
# Use MongoDB Atlas or production MongoDB instance
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/inclusive?retryWrites=true&w=majority
MONGO_ROOT_PASSWORD=strong-production-password-here

# Alternative: Production Docker MongoDB
# MONGO_URI=mongodb://admin:strong-password@mongodb:27017/inclusive?authSource=admin

# ====================================
# Authentication
# ====================================
# ⚠️ CRITICAL: Use a strong, randomly generated secret in production
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE-WITH-STRONG-RANDOM-SECRET

# ====================================
# AI Services (Production Keys)
# ====================================
# ⚠️ Use production API keys with proper rate limits
OPENAI_API_KEY=sk-your-production-openai-api-key
SERPER_API_KEY=your-production-serper-api-key
PINECONE_API_KEY=your-production-pinecone-api-key

# ====================================
# Next.js Configuration
# ====================================
NEXT_PUBLIC_API_URL=https://your-production-domain.com
NEXT_TELEMETRY_DISABLED=1

# ====================================
# Production Settings
# ====================================
DEBUG=false
LOG_LEVEL=error

# ====================================
# Security Headers (Optional)
# ====================================
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=900000
