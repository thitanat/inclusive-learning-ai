# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# ✅ .env.development - tracked (safe for team sharing)
# ✅ .env.example - tracked (template)
# ❌ .env.production - ignored (contains sensitive production credentials)
# ❌ .env.local - ignored (local overrides)
# ❌ .env - ignored (default)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docker & databases
backups/
backup/
*-backup/
atlas-backup/
docker-backup*/
*.dump
*.bson
mongo-data/

# mongodb exports
*.json
!package.json
!tsconfig.json
!next-env.d.ts

# docker volumes (if using bind mounts)
data/db/
data/configdb/

# deployment credentials & secrets
# ⚠️ NEVER commit these files - they contain sensitive information!
deploy/config.sh
deploy/*.ovpn
deploy/vpn-config.ovpn
deploy/*.key
deploy/*.pem

