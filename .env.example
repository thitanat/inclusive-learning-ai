# ====================================
# Inclusive Learning AI Platform
# Environment Configuration Template
# ====================================
# Copy this file to:
# - .env.development (for development - tracked in git)
# - .env.production (for production - NOT tracked in git)

# ====================================
# Application Settings
# ====================================
NODE_ENV=development
PORT=3005
HOSTNAME=localhost

# ====================================
# MongoDB Configuration
# ====================================
# Local Docker MongoDB
MONGO_URI=mongodb://admin:inclusive_admin_2026@localhost:27017/inclusive?authSource=admin
MONGO_ROOT_PASSWORD=inclusive_admin_2026

# MongoDB Atlas (Production)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/inclusive?retryWrites=true&w=majority

# ====================================
# Authentication
# ====================================
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ====================================
# AI Services
# ====================================
# OpenAI API Key (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Serper API Key (for web search)
# Get your API key from: https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Pinecone Vector Database (for curriculum search)
# Get your API key from: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX=inclusive-learning-curriculum

# ====================================
# Next.js Configuration
# ====================================
NEXT_PUBLIC_API_URL=http://localhost:3005
NEXT_TELEMETRY_DISABLED=1

# ====================================
# Optional Features
# ====================================
# Enable optimized LangChain pipeline
USE_OPTIMIZED_PIPELINE=true

# Log level (error, warn, info, debug)
LOG_LEVEL=info
DEBUG=false

# ====================================
# NOTES
# ====================================
# 1. Set NODE_ENV=development or production to auto-load .env.development or .env.production
# 2. Never commit .env.production with real credentials
# 3. .env.development can be tracked for team consistency
# 4. Generate strong secrets for production deployments
